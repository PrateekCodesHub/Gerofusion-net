# ==========================================
# GeroFusion Net .gitignore
# ==========================================

# Virtual Environments
venv/
env/
.env
.venv/
ENV/
env.bak/
venv.bak/
backend/venv310/
backend/backend/

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Node & Frontend dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/node_modules/
frontend/dist/
frontend/build/
.npm

# Large Datasets & Media
dataset/
*.zip
*.tar.gz
*.tar
*.7z
*.mp4
*.avi
*.mov
*.wav
*.mp3

# Ignore Presentation, Slides & Canva artifacts
*.pptx
*.svg
*.png
*.jpg
*.jpeg
*.html
*.txt
output/
"slide ppt content"/
"terminal commands"/
"final output images"/

# Ignore Batch files
*.bat

# Ignore root generator scripts
generate_*.py
create_*.py
merge_*.py
regenerate_*.py
add_saved_*.py
build_project_review_notes.py

# Heavy Model Checkpoints (> 50MB)
trained_models/*.h5
trained_models/*.pt
trained_models/*.pth
trained_models/*.ckpt

# IDE, Editor & OS artifacts
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Temporary & Log files
tmp/
*.log
